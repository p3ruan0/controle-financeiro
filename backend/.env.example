# Porta do Servidor
PORT=5000

# Conexão Banco de Dados (Prisma SQLite)
DATABASE_URL="file:./dev.db"

# Segredo JWT
JWT_SECRET="sua-chave-secreta-jwt-super-segura-aqui"

# Provedor de E-mail (SMTP) para Recuperação de Senha
# Exemplos de Provedores:
# Gmail: SMTP_HOST=smtp.gmail.com | SMTP_PORT=587 | SMTP_SECURE=false
# Mailtrap: SMTP_HOST=sandbox.smtp.mailtrap.io | SMTP_PORT=2525
# Brevo / Sendinblue: SMTP_HOST=smtp-relay.brevo.com | SMTP_PORT=587
# Resend / AWS SES / Hostinger / etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Fluxo de Caixa <nao-responda@fluxocaixa.com>"
RESET_TOKEN_EXPIRY_MINUTES=10
