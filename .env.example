# ==========================================
# Variáveis de Ambiente - Fluxo de Caixa
# ==========================================
# Copie este arquivo para .env na pasta /backend
# cp backend/.env.example backend/.env

# Porta de execução do servidor backend
PORT=5000

# URL de conexão com o banco de dados relacional (SQLite)
DATABASE_URL="file:./dev.db"

# Chave secreta para assinatura dos tokens JWT (use uma string longa e segura em produção)
JWT_SECRET="sua-chave-secreta-jwt-super-segura-aqui"
